# Single .env for the whole workspace, read by:
#   - packages/db  -> drizzle.config.ts (db:generate, db:migrate, db:push, db:studio)
#   - apps/web     -> next.config.ts loads it, since Next only looks next to the app
#   - apps/worker  -> the queue worker
DATABASE_URL=mysql://root:secret@localhost:3306/solara

# Signs the session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me

# Public URL of the web app, used to build the password recovery and the
# first-access links sent by e-mail.
APP_URL=http://localhost:3000

# SMTP server that sends the account e-mails (apps/web, lib/mail).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to true for implicit TLS (usually port 465).
SMTP_SECURE=false
# Leave both empty for servers that do not require authentication.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Solara <no-reply@solara.local>"

# Queue backing the timetabling worker (apps/worker).
REDIS_URL=redis://localhost:6379
TIMETABLING_QUEUE=timetabling
# The optimizer is CPU-bound, so keep this low.
WORKER_CONCURRENCY=1
