# Single .env for the whole workspace, read by:
#   - packages/db  -> drizzle.config.ts (db:generate, db:migrate, db:push, db:studio)
#   - apps/web     -> next.config.ts loads it, since Next only looks next to the app
#   - apps/worker  -> the queue worker
DATABASE_URL=mysql://root:secret@localhost:3306/solara

# Signs the session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me