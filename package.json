{
  "name": "solara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @solara/web dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @solara/web start",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:generate": "pnpm --filter @solara/db db:generate",
    "db:migrate": "pnpm --filter @solara/db db:migrate",
    "db:push": "pnpm --filter @solara/db db:push",
    "db:studio": "pnpm --filter @solara/db db:studio"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5"
  }
}