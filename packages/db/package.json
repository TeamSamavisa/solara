{
  "name": "@solara/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "Source is exported directly; consumers transpile it (Next via transpilePackages, worker via tsx). Subpaths mirror the previous @/lib/db/* layout so imports stay granular and mockable.",
  "exports": {
    "./client": "./src/client.ts",
    "./errors": "./src/errors.ts",
    "./pagination": "./src/pagination.ts",
    "./idempotency": "./src/idempotency.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./actions": "./src/actions/index.ts",
    "./actions/*": "./src/actions/*.ts"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "mysql2": "3.24.2",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "30.5.0",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "^20",
    "dotenv": "17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jest": "30.5.0",
    "ts-node": "10.9.2",
    "typescript": "^5"
  }
}
